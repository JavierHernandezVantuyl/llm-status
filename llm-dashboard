#!/usr/bin/env python3
"""
LLM Usage Dashboard - Cross-platform usage tracking

Lightweight tool to see usage across multiple LLM providers in one place.
Currently supports: Claude (more coming soon)

Usage:
    ./llm-dashboard              # Check all configured LLMs
    ./llm-dashboard claude       # Check specific LLM
    ./llm-dashboard --help       # Show help
"""

import sys
import argparse
from pathlib import Path

# Add parent directory to path
sys.path.insert(0, str(Path(__file__).parent))

from llm_dashboard.fetchers import FETCHERS
from llm_dashboard.display import format_usage_table, format_single_usage


def main():
    """Main entry point."""
    parser = argparse.ArgumentParser(
        description="LLM Usage Dashboard - See usage across all your LLMs",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  # Check all LLMs
  %(prog)s

  # Check specific LLM
  %(prog)s claude

  # List available LLMs
  %(prog)s --list

Currently supported:
  - Claude (Claude Code / claude.ai)

Coming soon:
  - OpenAI (ChatGPT API)
  - ChatGPT Web (chatgpt.com)
  - Gemini (Google AI)
  - DeepSeek
        """
    )

    parser.add_argument(
        'provider',
        nargs='?',
        choices=list(FETCHERS.keys()),
        help='Specific LLM provider to check (optional)'
    )

    parser.add_argument(
        '--list',
        action='store_true',
        help='List all available providers'
    )

    args = parser.parse_args()

    if args.list:
        print("\nAvailable LLM providers:")
        for name in FETCHERS.keys():
            print(f"  - {name}")
        print(f"\nTotal: {len(FETCHERS)} provider(s)")
        print("\nUsage: ./llm-dashboard [provider]\n")
        return 0

    # Fetch usage
    if args.provider:
        # Single provider
        fetcher_class = FETCHERS[args.provider]
        fetcher = fetcher_class()

        try:
            usage = fetcher.fetch_usage()
            print(format_single_usage(usage))

            return 0 if usage.status != "error" else 1
        except Exception as e:
            print(f"\n❌ Error fetching {args.provider} usage: {e}\n")
            return 1
    else:
        # All providers
        print("\n🔍 Fetching usage from all configured LLMs...\n")

        usages = []
        for provider_name, fetcher_class in FETCHERS.items():
            try:
                fetcher = fetcher_class()
                usage = fetcher.fetch_usage()
                usages.append(usage)
            except Exception as e:
                print(f"⚠️  Warning: Could not fetch {provider_name}: {e}")
                continue

        if not usages:
            print("\n❌ No usage data available\n")
            return 1

        print(format_usage_table(usages))
        return 0


if __name__ == "__main__":
    sys.exit(main())
